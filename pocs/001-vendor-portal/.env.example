# SendGrid Configuration
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=noreply@anzarenewables.com

# Application Configuration
BASE_URL=http://localhost:8000
DEBUG=True

# Instructions:
# 1. Sign up for free SendGrid account at https://sendgrid.com/
# 2. Create an API key in SendGrid dashboard (Settings > API Keys)
# 3. Copy this file to .env and replace 'your-sendgrid-api-key-here' with your actual API key
# 4. All emails will be sent to clafountain@anzarenewables.com (hardcoded in database.py)
